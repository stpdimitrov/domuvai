{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domuvai.bg/events/InsuranceLapsed.schema.json",
  "title": "InsuranceLapsed",
  "description": "Produced by `identity-org`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "firm_id",
    "lapsed_on",
    "policy_ref"
  ],
  "properties": {
    "firm_id": {
      "$ref": "#/$defs/Uuid"
    },
    "policy_ref": {
      "type": "string",
      "minLength": 1
    },
    "lapsed_on": {
      "$ref": "#/$defs/LegalDate"
    }
  },
  "$defs": {
    "LegalDate": {
      "type": "string",
      "format": "date",
      "description": "Europe/Sofia calendar date (PM-SYS-004)"
    },
    "Uuid": {
      "type": "string",
      "format": "uuid"
    }
  }
}
