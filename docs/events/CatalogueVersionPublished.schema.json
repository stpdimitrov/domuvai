{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domuvai.bg/events/CatalogueVersionPublished.schema.json",
  "title": "CatalogueVersionPublished",
  "description": "Produced by `law`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approved_at",
    "approved_by",
    "catalogue_version",
    "dv_reference"
  ],
  "properties": {
    "catalogue_version": {
      "type": "string",
      "minLength": 1
    },
    "approved_by": {
      "type": "string",
      "minLength": 1
    },
    "dv_reference": {
      "type": "string",
      "minLength": 1
    },
    "approved_at": {
      "$ref": "#/$defs/Instant"
    }
  },
  "$defs": {
    "Instant": {
      "type": "string",
      "format": "date-time",
      "description": "UTC instant"
    }
  }
}
