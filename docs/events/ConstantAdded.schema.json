{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domuvai.bg/events/ConstantAdded.schema.json",
  "title": "ConstantAdded",
  "description": "Produced by `law`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "in_force_from",
    "source",
    "value"
  ],
  "properties": {
    "code": {
      "type": "string",
      "minLength": 1
    },
    "value": {
      "type": "string",
      "minLength": 1
    },
    "in_force_from": {
      "$ref": "#/$defs/LegalDate"
    },
    "source": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "LegalDate": {
      "type": "string",
      "format": "date",
      "description": "Europe/Sofia calendar date (PM-SYS-004)"
    }
  }
}
