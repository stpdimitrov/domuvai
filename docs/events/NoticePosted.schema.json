{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domuvai.bg/events/NoticePosted.schema.json",
  "title": "NoticePosted",
  "description": "Produced by `notify`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "act_kind",
    "co_signed_by",
    "evidence_document_id",
    "notice_id",
    "posted_at"
  ],
  "properties": {
    "notice_id": {
      "$ref": "#/$defs/Uuid"
    },
    "act_kind": {
      "type": "string",
      "minLength": 1
    },
    "posted_at": {
      "$ref": "#/$defs/Instant"
    },
    "evidence_document_id": {
      "$ref": "#/$defs/Uuid"
    },
    "co_signed_by": {
      "$ref": "#/$defs/Uuid"
    }
  },
  "$defs": {
    "Instant": {
      "type": "string",
      "format": "date-time",
      "description": "UTC instant"
    },
    "Uuid": {
      "type": "string",
      "format": "uuid"
    }
  }
}
